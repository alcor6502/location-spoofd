config spoofd 'main'
	# Master switch: `spoofctl off` / `spoofctl on` (or edit and restart spoofd + firewall).
	option enabled '1'
	# Spoofed location: WGS-84 decimal degrees (right-click a point in Google Maps
	# or Apple Maps to copy them) and altitude in metres.
	option lat ''
	option lon ''
	option alt '0'
	# Reported accuracy in metres. Small values tell iOS the fix is precise.
	option hacc '5'
	option vacc '3'
	# Ports (8080/8443 are taken by uhttpd on GL.iNet). Keep in sync with /etc/firewall.spoofd.
	option tls_port '18443'
	option http_port '18080'
