#!/bin/sh /etc/rc.common
# procd service for spoofd on OpenWrt / GL.iNet. Install as /etc/init.d/spoofd.
# Location and options live in /etc/config/spoofd (created on first install).

USE_PROCD=1
START=99
STOP=10

start_service() {
	config_load spoofd
	local enabled lat lon alt hacc vacc tls_port http_port
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0
	config_get lat  main lat
	config_get lon  main lon
	if [ -z "$lat" ] || [ -z "$lon" ]; then
		logger -t spoofd "lat/lon not set in /etc/config/spoofd, not starting"
		return 1
	fi
	config_get alt  main alt  0
	config_get hacc main hacc 5
	config_get vacc main vacc 3
	config_get tls_port  main tls_port  18443
	config_get http_port main http_port 18080
	config_get dump_dir  main dump_dir           # debug only: raw request/response dumps
	config_get observe   main observe            # debug only: hosts to intercept, log and forward

	procd_open_instance
	procd_set_param command /usr/bin/spoofd -lat "$lat" -lon "$lon" -alt "$alt" -hacc "$hacc" -vacc "$vacc" \
		-listen ":$tls_port" -http ":$http_port" -ca-dir /etc/spoofd ${dump_dir:+-dump "$dump_dir"} ${observe:+-observe "$observe"}
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
