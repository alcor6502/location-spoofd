# spoofd configuration for pfSense — /usr/local/etc/spoofd.conf
# One option per line, name=value; every line is a spoofd flag (spoofd -h lists them).

# Spoofed location: WGS-84 decimal degrees (right-click a point in Google/Apple Maps).
lat=
lon=
alt=0            # altitude, metres

# Reported accuracy, metres. Smaller = iOS trusts this fix more; 1 is the minimum.
hacc=5
vacc=3

# Tailscale interface: spoofd loads the pf redirect into pfSense's anchors and removes it
# on stop. On pfSense tailscaled forwards exit-node traffic in userspace, so the redirect also
# diverts the host's own connections to Apple; spoofd's upstream connections are bound to
# pf-ports so they are not diverted back into it. Leave pf empty to manage pf yourself.
pf=tailscale0
pf-ports=18500-18599

# Ports (18443 receives the redirected HTTPS, 18080 serves the CA download and status page).
listen=:18443
http=:18080

# Where the CA, the neighbourhood cache and the per-device switch live.
ca-dir=/usr/local/etc/spoofd

# Polite mode: discard the location data a spoofed phone would upload to Apple.
polite=true

# Log file (the daemon also logs to stderr).
log=/var/log/spoofd.log
